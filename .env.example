# ---------------------------------------------------------------------------
# Luxe Home Estate — mühit dəyişənləri nümunəsi
# Bu faylı `.env` adı ilə kopyalayın və dəyərləri doldurun.
# ---------------------------------------------------------------------------

# Verilənlər bazası.
# Development üçün SQLite:
DATABASE_URL="file:./dev.db"
# Production üçün PostgreSQL nümunəsi (prisma/schema.prisma-da provider dəyişməlidir):
# DATABASE_URL="postgresql://user:password@host:5432/luxehomeestate?schema=public"

# Sessiya imzalama açarı. Təsadüfi, ən azı 32 simvol.
# Yaratmaq üçün:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="buraya-tesadufi-uzun-acar-yazin"

# Saytın tam ünvanı — canonical URL, sitemap və Open Graph üçün istifadə olunur.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# İlk super admin hesabı (yalnız `npm run db:seed` zamanı istifadə olunur).
SEED_ADMIN_EMAIL="admin@luxehomeestate.az"
SEED_ADMIN_PASSWORD="LuxeHomeEstate2026!"
