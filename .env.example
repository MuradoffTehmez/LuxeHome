# ---------------------------------------------------------------------------
# Luxe Home Estate — mühit dəyişənləri nümunəsi
# Bu faylı `.env` adı ilə kopyalayın və dəyərləri doldurun.
# Production dəyərləri Cloudflare secret-lərində saxlanılır (wrangler secret put).
# ---------------------------------------------------------------------------

# Prisma CLI üçün lokal SQLite faylı — yalnız miqrasiya generasiyası və seed üçün.
# Runtime-da sorğular D1 binding (env.DB) üzərindən gedir, bu dəyər istifadə olunmur.
DATABASE_URL="file:./dev.db"

# Sessiya imzalama açarı (jose JWT).
AUTH_SECRET="buraya-yazin"

# Saytın tam ünvanı — canonical URL, sitemap və Open Graph üçün.
# Production canonical host kod səviyyəsində https://luxehomeestate.az olaraq kilidlənib.
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Search Console verification token-i (yalnız token, tam meta tag deyil).
GOOGLE_SITE_VERIFICATION=""

# Analytics identifikatorları boş qalanda heç bir production analytics script-i yüklənmir.
# ID verilsə belə script yalnız istifadəçi analitika seçiminə açıq razılıq verdikdən sonra yüklənir.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID="GTM-MMV4VC9L"

# İlk super admin hesabı (yalnız seed zamanı).
SEED_ADMIN_EMAIL="admin@luxehomeestate.az"
SEED_ADMIN_PASSWORD="buraya-yazin"

# ---------------------------------------------------------------------------
# Resend E-poçt Xidməti
# ---------------------------------------------------------------------------
RESEND_API_KEY="buraya-yazin"

# ---------------------------------------------------------------------------
# Workers AI (elan təsviri və foto keyfiyyət analizi)
# ---------------------------------------------------------------------------
# API açarı YOXDUR: model `wrangler.jsonc`-dəki `AI` binding-i üzərindən işləyir.
# Aşağıdakı dəyişənlər yalnız defolt modeli dəyişmək üçündür — boş qalsa
# `src/lib/ai.ts`-dəki defoltlar işləyir.
AI_TEXT_MODEL=""
AI_VISION_MODEL=""

NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@luxehomeestate.az"
RESEND_WEBHOOK_SECRET="whsec_buraya-yazin"
TURNSTILE_SITE_KEY="0x4AAAAAA_yalniz_public_site_key"
TURNSTILE_SECRET="0x4AAAAAA_gizli_açar"
TURNSTILE_HOSTNAMES="localhost,127.0.0.1"
RESEND_FROM_EMAIL="Luxe Home Estate <notifications@luxehomeestate.az>"
NOTIFICATION_EMAIL="sales@luxehomeestate.az"

# ---------------------------------------------------------------------------
# Cron işlərinin açarı.
#
# `/api/cron/saved-search-digest` marşrutu «Gündəlik»/«Həftəlik» saxlanmış
# axtarış bildirişlərini göndərir və yalnız bu sirri daşıyan sorğunu qəbul edir:
#   Authorization: Bearer <CRON_SECRET>
#
# Sirr təyin edilməyibsə marşrut tamamilə bağlıdır (404 qaytarır) — «boş sirr»
# heç vaxt «hamıya açıq» demək olmamalıdır.
#
# Production: npx wrangler secret put CRON_SECRET
# Staging:    npx wrangler secret put CRON_SECRET --env staging
# ---------------------------------------------------------------------------
CRON_SECRET="buraya-yazin"

# ---------------------------------------------------------------------------
# İdarə paneli açarı — ilkin yayımda /admin və /giris bağlıdır.
# Açmaq üçün Cloudflare-də ADMIN_ENABLED="true" secret-i qoyulmalıdır.
# ---------------------------------------------------------------------------
ADMIN_ENABLED="true"
