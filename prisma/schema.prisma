// Luxe Home Estate — Prisma schema
//
// Provider: SQLite (Cloudflare D1). Runtime-da @prisma/adapter-d1 driver adapter istifadə olunur.
// Status/rol sahələri String saxlanılır;
// icazə verilən dəyərlər `src/lib/constants.ts` faylında toplanıb.

generator client {
  // Standart yer (node_modules/.prisma/client) qəsdən saxlanılır: yalnız paket adı ilə
  // idxal edildikdə `exports` şərtləri işləyir və Workers-də wasm engine seçilir.
  // Xüsusi `output` verilsəydi, bundler `index.js` (Node binary engine) götürərdi.
  provider = "prisma-client-js"
}

datasource db {
  // D1 SQLite-ə əsaslanır. Bu URL yalnız lokal seed/miqrasiya generasiyası üçündür;
  // production-da sorğular D1 binding (env.DB) üzərindən gedir.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// İSTİFADƏÇİLƏR VƏ ROLLAR
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            String    @default("EDITOR") // SUPER_ADMIN | ADMIN | EDITOR
  /// Hesabın kim olduğu: STAFF | USER | OWNER | AGENCY.
  /// `role` yalnız panel səlahiyyətini göstərir — iki ölçü qəsdən ayrıdır.
  accountType     String    @default("STAFF")
  phone           String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  /// İdarə panelində hesabın biznes baxımından yoxlanılıb təsdiqləndiyi vaxt.
  /// E-poçt doğrulamasından və bloklama (`isActive`) statusundan qəsdən ayrıdır.
  approvedAt      DateTime?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// İstifadəçinin seçdiyi dil: az | en | ru. `src/lib/constants.ts`-dəki LOCALES-dən.
  locale          String @default("az")
  /// light | dark | system — next-themes-in cari seçimini profil üzrə saxlayır.
  themePreference String @default("light")

  /// AES-GCM ilə şifrələnmiş TOTP sirri. Açıq mətn heç vaxt saxlanılmır.
  totpSecret         String?
  /// null = 2FA hələ qurulmayıb, ilk girişdə məcburi qurulum ekranı açılır
  totpEnabledAt      DateTime?
  mustChangePassword Boolean   @default(false)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?

  properties Property[] @relation("PropertyAuthor")
  posts      BlogPost[] @relation("PostAuthor")
  media      Media[]    @relation("MediaUploader")
  favorites  Favorite[]
  leadNotes  Lead[]     @relation("LeadAssignee")

  sessions                Session[]
  backupCodes             BackupCode[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  agency                  Agency?
  agencyEmployments       AgencyEmployee[]

  savedSearches          SavedSearch[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  reservations           Reservation[]
  reservationEvents      ReservationEvent[]      @relation("ReservationEventActor")
  agentProfile           AgentProfile?
  agentReviews           AgentReview[]           @relation("AgentReviewCustomer")
  aiContentDrafts        AiContentDraft[]

  partnersCreated Partner[] @relation("PartnerCreatedBy")
  partnersUpdated Partner[] @relation("PartnerUpdatedBy")
  partnersDeleted Partner[] @relation("PartnerDeletedBy")

  knowledgeArticles KnowledgeArticle[] @relation("KnowledgeArticleAuthor")

  @@index([role])
  @@index([accountType])
  @@index([approvedAt])
}

/// E-poçt doğrulama linkinin yalnız SHA-256 hash-i saxlanılır.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Parol bərpası tokeni birdəfəlikdir və açıq dəyəri bazada saxlanılmır.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Agentlik profili — yalnız `accountType = "AGENCY"` hesablarında olur.
/// `isVerified` admin təsdiqidir: təsdiqlənmiş agentliyin elanı birbaşa dərc olunur,
/// təsdiqlənməmişin elanı «Təsdiq gözləyir» statusunda qalır.
model Agency {
  id          String    @id @default(cuid())
  userId      String    @unique
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  phone       String?
  address     String?
  website     String?
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  /// Nümunə/demo qeydi — `Property.isDemo` ilə eyni semantika.
  isDemo      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employees     AgencyEmployee[]
  partners      AgencyPartner[]
  agentProfiles AgentProfile[]
  testimonials  Testimonial[]

  @@index([isVerified])
  @@index([isDemo])
}

/// Agentlik işçisi. Sahibin (Agency.userId) özü bura yazılmır — yalnız dəvət
/// olunan əməkdaşlar. Maksimum say (3) tətbiq səviyyəsində yoxlanılır, çünki
/// D1 tranzaksiya dəstəkləmədiyi üçün DB-səviyyəli CHECK etibarlı deyil.
model AgencyEmployee {
  id       String @id @default(cuid())
  agencyId String
  userId   String

  /// MANAGER | AGENT — sahibdən (owner) aşağı rol. Sahiblik `Agency.userId`-dədir.
  role   String @default("AGENT")
  /// PENDING | APPROVED | REJECTED — admin təsdiqi tələb olunur.
  status String @default("PENDING")

  invitedAt  DateTime  @default(now())
  approvedAt DateTime?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([agencyId, status])
}

/// Aktiv giriş sessiyaları. Cookie yalnız bu sətrin id-sini daşıyır, beləliklə
/// oğurlanmış cookie və ya işdən çıxan əməkdaşın girişi dərhal ləğv edilə bilir.
model Session {
  id          String    @id @default(cuid())
  userId      String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  ip          String?
  userAgent   String?
  revokedAt   DateTime?
  /// Sessiyanı açan TOTP addımı — eyni kodun təkrar oynadılmasının qarşısını alır
  totpCounter Int?
  /// STAFF_2FA | PUBLIC — sessiyanın hansı doğrulama axınından gəldiyi
  authKind    String    @default("STAFF_2FA")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// 2FA cihazı itirildikdə istifadə olunan birdəfəlik kodlar.
/// Kodlar yüksək entropiyalı təsadüfi dəyərlərdir, ona görə SHA-256 kifayətdir —
/// PBKDF2 burada yalnız boş yerə CPU yeyərdi.
model BackupCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Təhlükəsizlik jurnalı — uğurlu və uğursuz giriş cəhdləri.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  /// OK | BAD_PASSWORD | BAD_TOTP | LOCKED | RATE_LIMITED | INACTIVE
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

/// Brauzer error boundary-lərindən gələn, PII saxlamayan texniki xəta hadisəsi.
model ClientErrorEvent {
  id        String   @id @default(cuid())
  message   String
  digest    String?
  path      String?
  source    String   @default("client")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([digest, createdAt])
}

/// Real istifadəçidən gələn Core Web Vitals ölçümü.
model WebVitalMetric {
  id             String   @id @default(cuid())
  name           String
  value          Float
  rating         String
  path           String
  navigationType String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
}

/// Adminin AZ mənbə kontenti üçün hazırladığı strukturlaşdırılmış EN/RU tərcümə.
model ContentTranslation {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  locale          String
  status          String   @default("DRAFT")
  title           String?
  summary         String?
  content         String?
  metaTitle       String?
  metaDescription String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, entityId, locale])
  @@index([locale, status])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// TAKSONOMİYA
// ---------------------------------------------------------------------------

model PropertyType {
  id          String     @id @default(cuid())
  name        String
  searchName  String     @default("")
  slug        String     @unique
  description String?
  icon        String?
  imageUrl    String?
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  properties  Property[]
}

/// Yerləşmə ağacı. Bakı bazarında yer dörd paralel açarla göstərilir və istifadəçi
/// hər hansı biri ilə axtarır: rayon, metro, qəsəbə/mikrorayon, nişangah.
/// kind = "CITY" | "DISTRICT" | "METRO" | "SETTLEMENT" | "LANDMARK"
model Location {
  id         String  @id @default(cuid())
  name       String
  searchName String  @default("")
  slug       String  @unique
  kind       String  @default("CITY")
  parentId   String?
  order      Int     @default(0)

  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationTree")

  propertiesInCity     Property[]           @relation("PropertyCity")
  propertiesInDistrict Property[]           @relation("PropertyDistrict")
  propertiesNearMetro  Property[]           @relation("PropertyMetro")
  projects             Project[]            @relation("ProjectCity")
  neighborhoodProfile  NeighborhoodProfile?

  @@index([parentId])
  @@index([kind])
}

/// Əmlak xüsusiyyətləri (hovuz, qaraj, lift, ...).
model Feature {
  id         String  @id @default(cuid())
  name       String
  searchName String  @default("")
  slug       String  @unique
  icon       String?
  group      String  @default("GENERAL") // GENERAL | INDOOR | OUTDOOR | SECURITY
  order      Int     @default(0)

  properties PropertyFeature[]
}

model PropertyFeature {
  propertyId String
  featureId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feature  Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([propertyId, featureId])
  @@index([featureId])
}

// ---------------------------------------------------------------------------
// ƏMLAK
// ---------------------------------------------------------------------------

model Property {
  id          String @id @default(cuid())
  title       String
  slug        String @unique
  description String
  /// Azərbaycan diakritiklərindən asılı olmayan server axtarış indeksi.
  searchText  String @default("")

  /// SALE = Satılır, RENT = Kirayə
  listingType    String  @default("SALE")
  /// DRAFT | PENDING | PUBLISHED | RESERVED | SOLD | RENTED | ARCHIVED
  status         String  @default("DRAFT")
  /// Moderator PENDING elanı rədd edəndə yazdığı səbəb — sahibə "Elanlarım"da göstərilir.
  moderationNote String?

  price       Float
  currency    String  @default("AZN")
  /// Kirayə üçün: MONTH | DAY — satış üçün null
  pricePeriod String?

  typeId     String
  cityId     String
  districtId String?
  metroId    String?
  address    String?
  latitude   Float?
  longitude  Float?

  rooms       Int?
  bedrooms    Int?
  bathrooms   Int?
  area        Float?
  /// Torpaq sahəsi, sot (1 sot = 100 m²). Torpaq və həyət evi elanlarında m²-nin yerini tutur.
  landArea    Float?
  floor       Int?
  totalFloors Int?

  /// COSMETIC | RENOVATED | DESIGNER | UNRENOVATED | NEW_BUILDING
  renovation     String?
  /// TITLE_DEED (çıxarış) | CONTRACT (müqavilə) | NONE
  documentStatus String?

  videoUrl String?

  /// NEW = yeni tikili, OLD = köhnə tikili. Yerli bazarda bu, əmlak növündən ayrı
  /// ikinci ölçüdür: qiymət, sənəd vəziyyəti və ipoteka uyğunluğu birbaşa ondan asılıdır.
  buildingType         String? // NEW | OLD
  /// İpoteka Fondunun şərtlərinə uyğundur
  mortgageAvailable    Boolean @default(false)
  /// Tikinti şirkətinin daxili taksiti mövcuddur
  installmentAvailable Boolean @default(false)

  isFeatured         Boolean   @default(false)
  /// Premium boost yalnız bu tarix gələcəkdədirsə aktivdir; null köhnə müddətsiz featured qeydlər üçündür.
  featuredUntil      DateTime?
  /// Rezervasiya CTA-sı yalnız açıq şəkildə aktiv edilən elanlarda göstərilir.
  reservationEnabled Boolean   @default(false)
  /// Nümunə/demo qeydi — real məlumatla əvəzlənəndə false olur.
  isDemo             Boolean   @default(false)

  viewCount          Int       @default(0)
  publishedAt        DateTime?
  /// SOLD/RENTED/ARCHIVED vəziyyətinə ilk keçid; retention siyasəti bu real tarixdən hesablanır.
  closedAt           DateTime?
  /// Keçmiş elanın indeksdə saxlanıla biləcəyi son tarix. Null olduqda qlobal SEO siyasəti işləyir.
  retentionUntil     DateTime?
  /// Duplikat aşkarlanması üçün normallaşdırılmış ünvan+təsvir+əsas atribut fingerprint-i.
  contentFingerprint String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  metaTitle       String?
  metaDescription String?
  /// Google-a "bu URL-i indeksləşdirmə" deyir — duplikat və ya keçici səhifələr üçün.
  noIndex         Boolean @default(false)
  /// Boş buraxılsa canonical öz URL-inə işarə edir; yalnız duplikat kontent halında doldurulur.
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?

  type            PropertyType  @relation(fields: [typeId], references: [id])
  city            Location      @relation("PropertyCity", fields: [cityId], references: [id])
  district        Location?     @relation("PropertyDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  metro           Location?     @relation("PropertyMetro", fields: [metroId], references: [id], onDelete: SetNull)
  author          User?         @relation("PropertyAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId        String?
  assignedAgent   AgentProfile? @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedAgentId String?

  images             PropertyImage[]
  features           PropertyFeature[]
  leads              Lead[]
  favorites          Favorite[]
  savedSearchMatches SavedSearchMatch[]
  partners           PropertyPartner[]
  priceHistory       PropertyPriceHistory[]
  reservations       Reservation[]
  nearbyPlaces       NearbyPlace[]
  aiContentDrafts    AiContentDraft[]

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, listingType])
  @@index([typeId])
  @@index([cityId])
  @@index([districtId])
  @@index([metroId])
  @@index([price])
  @@index([isFeatured])
  @@index([featuredUntil])
  @@index([reservationEnabled, status])
  @@index([assignedAgentId])
  @@index([deletedAt])
  @@index([publishedAt])
  @@index([closedAt, retentionUntil])
  @@index([contentFingerprint])
  @@index([authorId])
}

model PropertyImage {
  id            String    @id @default(cuid())
  propertyId    String
  url           String
  thumbUrl      String?
  alt           String    @default("")
  caption       String?
  /// Eyni foto ilə təkrar elanları aşkarlamaq üçün upload qatının SHA-256 izi.
  checksum      String?
  width         Int?
  height        Int?
  order         Int       @default(0)
  isCover       Boolean   @default(false)
  qualityScore  Int?
  /// JSON massiv: blur, dark, low_resolution və s. maşınla oxunan xəbərdarlıqlar.
  qualityIssues String?
  analyzedAt    DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, order])
  @@index([checksum])
}

// ---------------------------------------------------------------------------
// LAYİHƏLƏR
// ---------------------------------------------------------------------------

model Project {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  summary     String?

  /// RESIDENTIAL | COMMERCIAL | VILLA | MIXED
  projectType String @default("RESIDENTIAL")
  /// PLANNED | ONGOING | COMPLETED
  status      String @default("ONGOING")

  cityId    String?
  address   String?
  latitude  Float?
  longitude Float?

  startDate    DateTime?
  deliveryDate DateTime?
  year         Int?

  totalArea  Float?
  floors     Int?
  unitCount  Int?
  /// Sərbəst xüsusiyyət siyahısı — JSON massiv (string[]).
  highlights String?
  /// Tikinti mərhələləri — JSON massiv ({ step, title, done }[]).
  timeline   String?

  coverUrl String?
  isDemo   Boolean @default(false)
  isActive Boolean @default(true)
  order    Int     @default(0)

  metaTitle       String?
  metaDescription String?
  /// Google-a "bu URL-i indeksləşdirmə" deyir — duplikat və ya keçici səhifələr üçün.
  noIndex         Boolean @default(false)
  /// Boş buraxılsa canonical öz URL-inə işarə edir; yalnız duplikat kontent halında doldurulur.
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  city       Location?        @relation("ProjectCity", fields: [cityId], references: [id], onDelete: SetNull)
  images     ProjectImage[]
  properties Property[]
  partners   ProjectPartner[]

  @@index([status])
  @@index([deletedAt])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  thumbUrl  String?
  alt       String  @default("")
  /// EXTERIOR | INTERIOR | CONSTRUCTION | LANDSCAPE
  category  String  @default("EXTERIOR")
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

// ---------------------------------------------------------------------------
// XİDMƏTLƏR
// ---------------------------------------------------------------------------

model Service {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  shortDescription String
  description      String
  icon             String  @default("Building2")
  imageUrl         String?
  /// Sərbəst maddələr — JSON massiv (string[]).
  bullets          String?
  order            Int     @default(0)
  isActive         Boolean @default(true)

  metaTitle       String?
  metaDescription String?
  /// Google-a "bu URL-i indeksləşdirmə" deyir — duplikat və ya keçici səhifələr üçün.
  noIndex         Boolean @default(false)
  /// Boş buraxılsa canonical öz URL-inə işarə edir; yalnız duplikat kontent halında doldurulur.
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// BLOQ
// ---------------------------------------------------------------------------

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  order       Int        @default(0)
  posts       BlogPost[]
}

model BlogPost {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  excerpt            String
  content            String
  coverUrl           String?
  coverAlt           String    @default("")
  categoryId         String?
  authorId           String?
  reviewerName       String?
  reviewedAt         DateTime?
  reviewAfter        DateTime?
  /// JSON massivləri: mövzu etiketləri, mənbələr və əlaqəli entity ID-ləri.
  tags               String?
  references         String?
  relatedPropertyIds String?
  relatedPostIds     String?

  /// DRAFT | PUBLISHED | ARCHIVED
  status      String    @default("DRAFT")
  isDemo      Boolean   @default(false)
  viewCount   Int       @default(0)
  readMinutes Int       @default(3)
  publishedAt DateTime?

  metaTitle       String?
  metaDescription String?
  /// Google-a "bu URL-i indeksləşdirmə" deyir — duplikat və ya keçici səhifələr üçün.
  noIndex         Boolean @default(false)
  /// Boş buraxılsa canonical öz URL-inə işarə edir; yalnız duplikat kontent halında doldurulur.
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([reviewAfter])
}

// ---------------------------------------------------------------------------
// MÜRACİƏTLƏR (LEADS)
// ---------------------------------------------------------------------------

model Lead {
  id      String  @id @default(cuid())
  name    String
  phone   String
  email   String?
  subject String?
  message String

  /// PROPERTY | CONTACT | SERVICE | PROJECT
  source String @default("CONTACT")
  /// NEW | CONTACTED | IN_PROGRESS | COMPLETED | CLOSED
  status String @default("NEW")

  propertyId String?
  adminNote  String?
  assigneeId String?

  /// Müraciətin hansı tərəfdaş/layihə kontekstindən gəldiyi — B2B atribusiya üçün.
  /// Boş qalması normaldır: adi əlaqə formasının tərəfdaşla bağlantısı yoxdur.
  partnerId String?
  projectId String?

  /// Organic/paid/direct atribusiyası `source` domen sahəsindən qəsdən ayrıdır.
  acquisitionSource String?
  acquisitionMedium String?
  landingPage       String?
  referrer          String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmTerm           String?
  utmContent        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignee User?     @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  partner  Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([propertyId])
  @@index([partnerId])
  @@index([acquisitionSource, acquisitionMedium, createdAt])
}

// ---------------------------------------------------------------------------
// FAVORİTLƏR
// ---------------------------------------------------------------------------

/// Qeydiyyatsız istifadəçilər üçün favoritlər localStorage-də saxlanılır.
/// Bu model gələcək istifadəçi hesabları üçün backend sinxronizasiyasını təmin edir.
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// SAXLANMIŞ AXTARIŞLAR VƏ BİLDİRİŞLƏR
// ---------------------------------------------------------------------------

/// İstifadəçinin saxladığı filtr kombinasiyası. `filters` PropertyFilters JSON-udur
/// (queries.ts ilə eyni forma — axtarış səhifəsindəki filtrlərlə birbaşa uyğunlaşır).
model SavedSearch {
  id             String    @id @default(cuid())
  userId         String
  name           String
  filters        String // JSON — PropertyFilters (sort/page/pageSize xaric)
  /// IMMEDIATE | DAILY | WEEKLY | OFF
  frequency      String    @default("DAILY")
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  lastCheckedAt  DateTime?
  lastNotifiedAt DateTime?

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches SavedSearchMatch[]

  @@index([userId])
  @@index([enabled])
}

/// Təkrar bildirişin qarşısını alır — eyni əmlak eyni saxlanmış axtarışa bir dəfə əlavə olunur.
model SavedSearchMatch {
  id            String    @id @default(cuid())
  savedSearchId String
  propertyId    String
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  savedSearch SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([savedSearchId, propertyId])
  @@index([propertyId])
}

/// Ümumi bildiriş qeydi — Saved Search matching ilə başlayır, gələcək bildiriş
/// növləri (Price Drop, Meeting Reminder) eyni cədvəldən istifadə edəcək.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// SAVED_SEARCH_MATCH | PRICE_DROP | MEETING_REMINDER (gələcək)
  type      String
  title     String
  content   String
  actionUrl String?
  /// Eyni domen hadisəsinin iki dəfə bildiriş yaratmasını bloklayan optional açar.
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// PUBLIC PLATFORM — PHASE 2
// ---------------------------------------------------------------------------

/// Brauzerin Web Push endpoint-i. Endpoint və açarlar yalnız server tərəfində istifadə olunur.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  locale     String    @default("az")
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Bildiriş kanalları və push sakit saatları istifadəçi üzrə bir sətirdə saxlanılır.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  savedSearchEmail      Boolean  @default(true)
  savedSearchWeb        Boolean  @default(true)
  savedSearchPush       Boolean  @default(false)
  priceDropEmail        Boolean  @default(true)
  priceDropWeb          Boolean  @default(true)
  priceDropPush         Boolean  @default(false)
  reservationEmail      Boolean  @default(true)
  reservationWeb        Boolean  @default(true)
  reservationPush       Boolean  @default(false)
  recommendationEnabled Boolean  @default(true)
  quietHoursStart       String?
  quietHoursEnd         String?
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Append-only qiymət dəyişikliyi. UI və Price Drop alert bu cədvəldən oxuyur.
model PropertyPriceHistory {
  id          String   @id @default(cuid())
  propertyId  String
  oldPrice    Float
  newPrice    Float
  currency    String   @default("AZN")
  source      String   @default("ADMIN") // ADMIN | OWNER | IMPORT | SYSTEM
  changedById String?
  changedAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, changedAt])
}

/// İctimai agent profili User hesabından ayrıdır, amma lazım olduqda bir hesaba bağlanır.
model AgentProfile {
  id              String   @id @default(cuid())
  userId          String?  @unique
  agencyId        String?
  slug            String   @unique
  name            String
  avatarUrl       String?
  roleTitle       String?
  specialization  String?
  experienceYears Int?
  bio             String?
  phone           String?
  whatsapp        String?
  email           String?
  languages       String   @default("[]")
  areas           String   @default("[]")
  isVerified      Boolean  @default(false)
  isPublic        Boolean  @default(false)
  /// Nümunə/demo qeydi — `Property.isDemo` ilə eyni semantika.
  isDemo          Boolean  @default(false)
  soldCount       Int      @default(0)
  rentedCount     Int      @default(0)
  responseMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  agency       Agency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  properties   Property[]
  reviews      AgentReview[]
  testimonials Testimonial[]
  reservations Reservation[]

  @@index([agencyId, isPublic])
  @@index([isVerified, isPublic])
  @@index([isDemo])
}

/// Agent rəyi yalnız APPROVED statusunda ictimai görünür.
model AgentReview {
  id             String    @id @default(cuid())
  agentId        String
  customerId     String?
  customerName   String
  rating         Int
  comment        String
  serviceType    String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | HIDDEN
  moderationNote String?
  createdAt      DateTime  @default(now())
  moderatedAt    DateTime?

  agent    AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  customer User?        @relation("AgentReviewCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([agentId, status, createdAt])
  @@index([customerId])
}

/// Şirkət rəyi admin təsdiqindən sonra home/haqqımızda səthlərində göstərilə bilər.
model Testimonial {
  id           String    @id @default(cuid())
  customerName String
  avatarUrl    String?
  review       String
  rating       Int
  serviceType  String?
  agentId      String?
  agencyId     String?
  status       String    @default("PENDING")
  occurredAt   DateTime?
  createdAt    DateTime  @default(now())
  approvedAt   DateTime?

  agent  AgentProfile? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agency Agency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([agentId])
  @@index([agencyId])
}

/// Rayon üzrə təsdiqlənmiş statistik/prose məlumatı. Null göstəricilər UI-da uydurulmur.
model NeighborhoodProfile {
  id                  String    @id @default(cuid())
  locationId          String    @unique
  description         String?
  descriptionEn       String?
  descriptionRu       String?
  coverUrl            String?
  averagePrice        Float?
  medianPrice         Float?
  averagePricePerSqm  Float?
  saleRentRatio       Float?
  annualChangePercent Float?
  averageRent         Float?
  rentalYieldPercent  Float?
  dataSource          String?
  measuredAt          DateTime?
  updatedAt           DateTime  @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

/// Əmlaka yaxın təsdiqlənmiş obyekt; mənbə və məsafə üsulu açıq saxlanılır.
model NearbyPlace {
  id             String   @id @default(cuid())
  propertyId     String
  category       String
  name           String
  latitude       Float?
  longitude      Float?
  distanceMeters Int?
  walkingMinutes Int?
  source         String?
  createdAt      DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, category])
}

/// Rezervasiyanın cari vəziyyəti; bütün status keçidləri ReservationEvent-də append-only qalır.
model Reservation {
  id              String    @id @default(cuid())
  propertyId      String
  userId          String
  agentId         String?
  firstName       String
  lastName        String
  phone           String
  email           String
  requestedFor    DateTime
  message         String?
  status          String    @default("REQUESTED")
  termsAcceptedAt DateTime
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  property Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    AgentProfile?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  events   ReservationEvent[]

  @@index([userId, createdAt])
  @@index([propertyId, status])
  @@index([agentId, status])
}

model ReservationEvent {
  id            String   @id @default(cuid())
  reservationId String
  status        String
  note          String?
  changedById   String?
  source        String   @default("USER")
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("ReservationEventActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
}

/// AI mətn nəticəsi həmişə draft kimi saxlanılır və insan təsdiqi olmadan əmlaka yazılmır.
model AiContentDraft {
  id            String    @id @default(cuid())
  propertyId    String?
  requestedById String
  locale        String    @default("az")
  inputJson     String
  outputJson    String
  provider      String
  model         String
  status        String    @default("DRAFT") // DRAFT | APPLIED | DISCARDED
  createdAt     DateTime  @default(now())
  appliedAt     DateTime?

  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requestedBy User      @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@index([requestedById, createdAt])
}

// ---------------------------------------------------------------------------
// MEDİA VƏ PARAMETRLƏR
// ---------------------------------------------------------------------------

model Media {
  id               String  @id @default(cuid())
  url              String  @unique
  thumbUrl         String?
  originalName     String
  mimeType         String
  size             Int
  width            Int?
  height           Int?
  alt              String  @default("")
  caption          String?
  checksum         String?
  watermarkApplied Boolean @default(false)
  uploaderId       String?

  createdAt DateTime @default(now())

  uploader User? @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([checksum])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Panel əməliyyatlarının izi: kim, nə vaxt, hansı qeydə nə etdi.
/// Sətirlər heç vaxt yenilənmir və redaktorlar tərəfindən silinə bilmir.
model AuditLog {
  id        String  @id @default(cuid())
  userId    String?
  userEmail String
  /// CREATE | UPDATE | DELETE | RESTORE | PUBLISH | LOGIN_REVOKE | ROLE_CHANGE | UPLOAD
  action    String
  /// Property | Project | BlogPost | Service | Lead | Media | User | Setting
  entity    String
  entityId  String?
  /// Qısa insan oxunaqlı təsvir (məsələn elanın başlığı).
  summary   String?
  /// Həssas dəyərlər yazılmadan əvvəl çağıran tərəfindən maskalanmış JSON snapshot.
  oldValue  String?
  newValue  String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/// Korporativ e-poçtun məzmununu deyil, çatdırılma və qəbul metadatasını saxlayır.
model EmailActivity {
  id              String   @id @default(cuid())
  providerId      String   @unique
  direction       String // OUTBOUND | INBOUND
  eventType       String
  fromAddress     String?
  toAddresses     String   @default("[]")
  subject         String?
  messageId       String?
  attachmentCount Int      @default(0)
  lastEventAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([direction, lastEventAt])
  @@index([eventType, lastEventAt])
}

/// Yüngül domen hadisə jurnalı (outbox pattern). D1 tranzaksiya dəstəkləmədiyi
/// üçün tam event-sourcing/CQRS burada mənasız risk daşıyır — bunun əvəzinə
/// hər əhəmiyyətli yazı əməliyyatından sonra ayrıca INSERT ilə hadisə qeyd olunur.
/// `AuditLog`-dan fərqi: bu, "kim etdi" deyil, "sistemdə nə baş verdi" səviyyəsidir
/// və gələcəkdə bildiriş/analitika abunəçiləri üçün mənbədir.
model DomainEvent {
  id         String  @id @default(cuid())
  /// property.published | agency.employee_requested | lead.created və s.
  type       String
  entityType String
  entityId   String
  /// JSON sətir kimi saxlanılır — D1-də native JSON tipi yoxdur.
  payload    String?

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// YÖNLƏNDİRMƏLƏR VƏ 404 İZLƏMƏSİ
// ---------------------------------------------------------------------------

/// Köhnə/dəyişmiş URL-ləri yeni ünvana yönləndirir. `/[...slug]` catch-all
/// route-u hər 404-də bu cədvəli yoxlayır — uyğunluq tapılmasa əsl 404 göstərilir.
model Redirect {
  id         String  @id @default(cuid())
  /// Aparıcı `/` ilə, sorğu sətri olmadan — məsələn `/emlaklar/kohne-slug`.
  fromPath   String  @unique
  toPath     String
  /// 301 = daimi (SEO dəyərini ötürür), 302 = müvəqqəti.
  statusCode Int     @default(301)
  isActive   Boolean @default(true)
  hitCount   Int     @default(0)
  createdBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// Uyğun yönləndirməsi olmayan 404-lərin qeydi — admin bunlardan hansı
/// yönləndirmələrin əlavə edilməli olduğunu görür.
model NotFoundHit {
  id          String   @id @default(cuid())
  path        String   @unique
  count       Int      @default(1)
  referrer    String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([count])
}

// ---------------------------------------------------------------------------
// TƏRƏFDAŞLAR (PARTNERS)
// ---------------------------------------------------------------------------

/// Rəsmi biznes tərəfdaşı — broker, agentlik, developer, bank, texnologiya şirkəti.
///
/// `Agency`-dən fərqi qəsdəndir: `Agency` saytda hesabı olan və elan yerləşdirən
/// istifadəçi profilidir, `Partner` isə şirkətlə bağlanmış xarici əməkdaşlıqdır və
/// istifadəçi hesabı tələb etmir. İkisi `AgencyPartner` üzərindən əlaqələndirilə bilir.
///
/// Public görünüş bir sahədən deyil, bir neçə şərtin birləşməsindən asılıdır —
/// məntiq `src/lib/partners.ts`-də toplanıb və hər sorğu oradan keçir.
model Partner {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  /// Rəsmi hüquqi ad — dublikat yoxlamasında da istifadə olunur.
  legalName String?

  /// İctimai prose. AZ əsas dildir; EN/RU boş qalsa AZ mətni göstərilir.
  shortDescription   String?
  shortDescriptionEn String?
  shortDescriptionRu String?
  /// Zəngin mətn (HTML). Yazılmadan əvvəl `sanitizeContentHtml()` ilə süzülür.
  description        String?
  descriptionEn      String?
  descriptionRu      String?
  /// Admin tərəfindən idarə olunan hüquqi bildiriş — mətn heç vaxt koddan gəlmir.
  disclaimer         String?
  disclaimerEn       String?
  disclaimerRu       String?

  websiteUrl String?
  email      String?
  phone      String?
  whatsapp   String?

  /// Əsas loqo. `logoLight`/`logoDark` yalnız brend iki variant verəndə doldurulur;
  /// boş qalsa hər iki temada `logoUrl` göstərilir.
  logoUrl    String?
  logoLight  String?
  logoDark   String?
  coverImage String?

  country String?
  city    String?
  address String?

  /// `PARTNERSHIP_TYPES` — `src/lib/constants.ts`.
  partnershipType String @default("OTHER")
  /// `PARTNER_STATUSES` — `src/lib/constants.ts`.
  status          String @default("DRAFT")

  /// Admin sənədlə təsdiqlədi. «Rəsmi tərəfdaş» nişanı üçün məcburi şərtlərdən biridir.
  verified        Boolean   @default(false)
  verifiedAt      DateTime?
  officialPartner Boolean   @default(false)
  featured        Boolean   @default(false)
  showPublicly    Boolean   @default(false)
  showOnHomepage  Boolean   @default(false)

  officialSince      DateTime?
  partnershipEndDate DateTime?

  sortOrder Int @default(0)

  /// Nümunə/demo qeydi — `Property.isDemo` ilə eyni semantika.
  isDemo Boolean @default(false)

  seoTitle       String?
  seoDescription String?
  /// Vergüllə ayrılmış açar sözlər — `buildMetadata({ keywords })`-ə verilir.
  seoKeywords    String?
  ogImage        String?

  // --- Müqavilə metadatası: yalnız `partner:contract` icazəsi ilə görünür ---
  contractNumber    String?
  contractStartDate DateTime?
  contractEndDate   DateTime?
  /// Sənədin R2 açarı və ya ünvanı. İctimai sorğu bu sahəni heç vaxt seçmir.
  contractDocument  String?
  internalNotes     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Yumşaq silmə — əlaqəli elan və layihələrin bütövlüyü pozulmasın deyə.
  deletedAt DateTime?

  createdById String?
  updatedById String?
  deletedById String?

  createdBy User? @relation("PartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("PartnerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy User? @relation("PartnerDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  properties PropertyPartner[]
  projects   ProjectPartner[]
  agencies   AgencyPartner[]
  leads      Lead[]

  @@index([slug])
  @@index([status])
  @@index([partnershipType])
  @@index([featured])
  @@index([showPublicly])
  @@index([showOnHomepage])
  @@index([officialSince])
  @@index([deletedAt])
  @@index([status, showPublicly, deletedAt])
  @@index([sortOrder])
  @@index([isDemo])
}

/// Elan ↔ tərəfdaş. Çox-çoxa: bir elanda developer, satış tərəfdaşı və broker
/// eyni anda ola bilər, ona görə `Property.partnerId` kifayət etmir.
/// (`Listing` bu layihədə `Property` adlanır — PRD-dəki `ListingPartner` budur.)
model PropertyPartner {
  id         String @id @default(cuid())
  propertyId String
  partnerId  String

  /// `PARTNER_RELATION_ROLES` — `src/lib/constants.ts`.
  role      String  @default("SOURCE")
  /// Tərəfdaşın öz saytındakı elan ünvanı — mənbə şəffaflığı üçün.
  sourceUrl String?
  isPublic  Boolean @default(true)
  /// Elan səhifəsində göstərilən əsas tərəfdaş. Tətbiq səviyyəsində birdən çox
  /// olmaması təmin edilir — D1 tranzaksiya dəstəkləmədiyi üçün DB constraint etibarlı deyil.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  partner  Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, partnerId, role])
  @@index([partnerId])
  @@index([propertyId, isPublic])
}

/// Yaşayış kompleksi ↔ tərəfdaş.
model ProjectPartner {
  id        String @id @default(cuid())
  projectId String
  partnerId String

  role      String  @default("DEVELOPER")
  /// Tərəfdaşın öz saytındakı layihə ünvanı.
  sourceUrl String?
  isPublic  Boolean @default(true)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([projectId, partnerId, role])
  @@index([partnerId])
  @@index([projectId, isPublic])
}

/// Agentlik ↔ tərəfdaş.
///
/// PRD-dəki `AgentPartner` bu layihədə agentlik səviyyəsinə düşür: ayrıca `Agent`
/// modeli yoxdur, agent `AgencyEmployee` kimi agentliyə bağlıdır. Beləliklə
/// «agent hansı tərəfdaşla işləyir» sualı agentlik üzərindən cavablanır və
/// paralel model yaradılmır.
model AgencyPartner {
  id        String @id @default(cuid())
  agencyId  String
  partnerId String

  role     String  @default("BROKER")
  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([agencyId, partnerId])
  @@index([partnerId])
}

// ---------------------------------------------------------------------------
// BİLİK MƏRKƏZİ (REAL ESTATE KNOWLEDGE HUB)
// ---------------------------------------------------------------------------

/// Bilik Mərkəzinin kateqoriyası — bələdçilər və lüğət terminləri eyni ağacı bölüşür.
///
/// Bloq kateqoriyasından **ayrıdır**: bloq xəbər/kampaniya axınıdır, Bilik Mərkəzi isə
/// köhnəlməyən təlimat məzmunudur. İki axını bir cədvəldə birləşdirmək SEO baxımından
/// da səhv olardı — bələdçi `Article` deyil, `HowTo`/`FAQPage` siqnalı verir.
model KnowledgeCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// Azərbaycan diakritiklərindən asılı olmayan axtarış indeksi (`normalizeSearchText`).
  searchName  String  @default("")
  description String?
  /// lucide-react ikon adı — `admin-icon.tsx`-dəki icazə siyahısından.
  icon        String?
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles KnowledgeArticle[]
  terms    KnowledgeTerm[]

  @@index([isActive, order])
}

/// Bilik Mərkəzi bələdçisi — addım-addım təlimat və izah məzmunu.
model KnowledgeArticle {
  id         String @id @default(cuid())
  slug       String @unique
  title      String
  /// Registrsiz/diakritiksiz axtarış üçün normallaşdırılmış başlıq + xülasə.
  searchText String @default("")
  excerpt    String
  /// `sanitizeRichText()`-dən keçmiş HTML. Bazadakı dəyər həmişə təhlükəsizdir.
  content    String

  categoryId String?
  /// BUYER | SELLER | RENTER | LANDLORD | INVESTOR — kimə ünvanlanıb.
  audience   String  @default("BUYER")
  /// BEGINNER | INTERMEDIATE | ADVANCED
  level      String  @default("BEGINNER")
  /// DRAFT | PUBLISHED — `POST_STATUSES` ilə eyni dəyər dəsti.
  status     String  @default("DRAFT")

  /// CURRENT | PROPOSAL | MIXED — qüvvədə olan norma ilə təşəbbüsü ayırır.
  legalStatus     String    @default("CURRENT")
  /// GREEN | YELLOW | RED | LEGAL_REVIEW — məqalənin universal risk siqnalı.
  riskLevel       String    @default("YELLOW")
  jurisdiction    String    @default("Azərbaycan Respublikası")
  /// Hüquqşünasın məzmunu son dəfə qüvvədə olan aktlarla yoxladığı tarix.
  legalReviewedAt DateTime?
  /// JSON sətir massivləri: D1 native array saxlamır.
  legalActs       String?
  sourceUrls      String?

  /// Sənəddə müəyyən edilən vahid hüquqi bloklar; HTML yazı anında sanitizasiya olunur.
  legalBasis        String?
  requiredDocuments String?
  procedure         String?
  duration          String?
  costs             String?
  risks             String?
  checklist         String?
  template          String?
  courtPosition     String?

  readMinutes Int     @default(1)
  isFeatured  Boolean @default(false)
  viewCount   Int     @default(0)
  /// Nümunə/demo qeydi — ictimai sorğular yalnız `false` qaytarır.
  isDemo      Boolean @default(false)

  coverUrl String?
  coverAlt String  @default("")

  authorId           String?
  reviewerName       String?
  reviewedAt         DateTime?
  reviewAfter        DateTime?
  /// JSON massivləri: mövzu etiketləri və əlaqəli content/entity ID-ləri.
  tags               String?
  relatedPropertyIds String?
  relatedArticleIds  String?

  metaTitle       String?
  metaDescription String?
  noIndex         Boolean @default(false)
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?

  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?              @relation("KnowledgeArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([audience])
  @@index([legalStatus, legalReviewedAt])
  @@index([riskLevel])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([reviewAfter])
}

// ---------------------------------------------------------------------------
// SERP EKOSİSTEMİ
// ---------------------------------------------------------------------------

/// İstənilən public entity üçün locale-səviyyəli metadata override-i.
model SeoMetadata {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  locale        String   @default("az")
  title         String?
  description   String?
  canonical     String?
  robotsIndex   Boolean  @default(true)
  robotsFollow  Boolean  @default(true)
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityType, entityId, locale])
  @@index([entityType, locale])
}

/// Nəzarətli programmatic SEO səhifəsi; limitsiz filter URL-lərini əvəz edir.
model SeoLandingPage {
  id               String    @id @default(cuid())
  locale           String    @default("az")
  slug             String
  name             String
  title            String
  h1               String
  description      String
  introContent     String
  bottomContent    String?
  filtersJson      String
  faqJson          String    @default("[]")
  relatedPathsJson String    @default("[]")
  indexable        Boolean   @default(false)
  indexEmpty       Boolean   @default(false)
  minInventory     Int       @default(5)
  canonical        String?
  status           String    @default("DRAFT")
  publishedAt      DateTime?
  updatedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([locale, slug])
  @@index([status, indexable, locale])
}

/// Keyword intent/cluster və target URL xəritəsi; rank API-dən asılı deyil.
model SeoKeyword {
  id              String    @id @default(cuid())
  keyword         String
  locale          String    @default("az")
  intent          String
  cluster         String
  targetUrl       String
  priority        Int       @default(3)
  searchVolume    Int?
  currentPosition Float?
  measuredAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([keyword, locale])
  @@index([cluster, priority])
  @@index([targetUrl])
}

/// Organization, office, agent və agency üçün vahid semantic entity registry-si.
model EntityProfile {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String?
  locale      String   @default("az")
  slug        String
  name        String
  legalName   String?
  description String?
  schemaType  String
  dataJson    String   @default("{}")
  isPublic    Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, slug, locale])
  @@index([entityId, locale])
  @@index([isPublic, entityType])
}

/// Periodik audit nəticəsi; həll olunan qeydlər tarixçədən silinmir.
model SeoAuditIssue {
  id         String    @id @default(cuid())
  type       String
  severity   String
  url        String
  entityType String?
  entityId   String?
  message    String
  status     String    @default("OPEN")
  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, severity, detectedAt])
  @@index([entityType, entityId])
  @@index([url])
}

/// Search Console import/sync nəticələrinin gündəlik aqreqatı.
model SeoSearchMetric {
  id          String   @id @default(cuid())
  date        DateTime
  query       String   @default("")
  page        String   @default("")
  country     String   @default("")
  device      String   @default("")
  clicks      Float    @default(0)
  impressions Float    @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([date, query, page, country, device])
  @@index([date])
  @@index([page, date])
}

/// Kritik crawl/index hadisələri üçün həll edilə bilən xəbərdarlıq.
model SeoAlert {
  id         String    @id @default(cuid())
  type       String
  severity   String
  message    String
  status     String    @default("OPEN")
  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, severity, detectedAt])
}

/// Daşınmaz əmlak terminlərinin lüğəti.
///
/// Ayrıca model saxlanılır, çünki termin səhifəsi `DefinedTerm` struktur datası verir
/// və uzun bələdçidən fərqli olaraq bir abzaslıq cavab üçün optimallaşdırılır.
model KnowledgeTerm {
  id              String  @id @default(cuid())
  slug            String  @unique
  term            String
  /// Normallaşdırılmış termin — registrsiz axtarış üçün.
  searchName      String  @default("")
  /// Bir cümləlik tərif — kart və snippet üçün.
  shortDefinition String
  /// Genişləndirilmiş izah (sanitizasiya olunmuş HTML). Boş buraxıla bilər.
  definition      String?
  /// Terminin ilk hərfi (normallaşdırılmış, böyük) — hərf indeksində qruplaşdırma üçün.
  initial         String  @default("")

  categoryId String?
  /// DRAFT | PUBLISHED
  status     String  @default("DRAFT")
  order      Int     @default(0)

  /// Əlaqəli terminlərin slug-ları — JSON massiv. D1-də massiv tipi yoxdur.
  relatedSlugs String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, initial])
  @@index([categoryId])
}

/// CMS-dən idarə olunan FAQ (Public PRD §86-87).
///
/// Əvvəl suallar `src/i18n/public-content.ts`-də sabit idi: yeni sual əlavə etmək
/// yayım tələb edirdi. İndi baza boşdursa həmin sabit kataloq fallback kimi işləyir,
/// ona görə keçid sıfır boşluqla gedir.
model KnowledgeFaq {
  id       String @id @default(cuid())
  question String
  /// Sanitizasiya olunmuş HTML cavab.
  answer   String
  /// PURCHASE | RENT | RESERVATION | AGENCY | PAYMENT | LEGAL | PLATFORM
  category String @default("PLATFORM")
  status   String @default("DRAFT")
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, category, order])
}
