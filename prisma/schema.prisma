// Luxe Home Estate — Prisma schema
//
// Provider: SQLite (Cloudflare D1). Runtime-da @prisma/adapter-d1 driver adapter istifadə olunur.
// Status/rol sahələri String saxlanılır;
// icazə verilən dəyərlər `src/lib/constants.ts` faylında toplanıb.

generator client {
  // Standart yer (node_modules/.prisma/client) qəsdən saxlanılır: yalnız paket adı ilə
  // idxal edildikdə `exports` şərtləri işləyir və Workers-də wasm engine seçilir.
  // Xüsusi `output` verilsəydi, bundler `index.js` (Node binary engine) götürərdi.
  provider = "prisma-client-js"
}

datasource db {
  // D1 SQLite-ə əsaslanır. Bu URL yalnız lokal seed/miqrasiya generasiyası üçündür;
  // production-da sorğular D1 binding (env.DB) üzərindən gedir.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


// ---------------------------------------------------------------------------
// İSTİFADƏÇİLƏR VƏ ROLLAR
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("EDITOR") // SUPER_ADMIN | ADMIN | EDITOR
  /// Hesabın kim olduğu: STAFF | USER | OWNER | AGENCY.
  /// `role` yalnız panel səlahiyyətini göstərir — iki ölçü qəsdən ayrıdır.
  accountType  String    @default("STAFF")
  phone        String?
  emailVerifiedAt DateTime?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// İstifadəçinin seçdiyi dil: az | en | ru. `src/lib/constants.ts`-dəki LOCALES-dən.
  locale           String @default("az")
  /// light | dark | system — next-themes-in cari seçimini profil üzrə saxlayır.
  themePreference  String @default("system")

  /// AES-GCM ilə şifrələnmiş TOTP sirri. Açıq mətn heç vaxt saxlanılmır.
  totpSecret         String?
  /// null = 2FA hələ qurulmayıb, ilk girişdə məcburi qurulum ekranı açılır
  totpEnabledAt      DateTime?
  mustChangePassword Boolean   @default(false)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?

  properties Property[]  @relation("PropertyAuthor")
  posts      BlogPost[]  @relation("PostAuthor")
  media      Media[]     @relation("MediaUploader")
  favorites  Favorite[]
  leadNotes  Lead[]      @relation("LeadAssignee")

  sessions    Session[]
  backupCodes BackupCode[]
  agency      Agency?
  agencyEmployments AgencyEmployee[]

  @@index([role])
  @@index([accountType])
}

/// Agentlik profili — yalnız `accountType = "AGENCY"` hesablarında olur.
/// `isVerified` admin təsdiqidir: təsdiqlənmiş agentliyin elanı birbaşa dərc olunur,
/// təsdiqlənməmişin elanı «Təsdiq gözləyir» statusunda qalır.
model Agency {
  id          String    @id @default(cuid())
  userId      String    @unique
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  phone       String?
  address     String?
  website     String?
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employees AgencyEmployee[]

  @@index([isVerified])
}

/// Agentlik işçisi. Sahibin (Agency.userId) özü bura yazılmır — yalnız dəvət
/// olunan əməkdaşlar. Maksimum say (3) tətbiq səviyyəsində yoxlanılır, çünki
/// D1 tranzaksiya dəstəkləmədiyi üçün DB-səviyyəli CHECK etibarlı deyil.
model AgencyEmployee {
  id       String @id @default(cuid())
  agencyId String
  userId   String

  /// MANAGER | AGENT — sahibdən (owner) aşağı rol. Sahiblik `Agency.userId`-dədir.
  role   String @default("AGENT")
  /// PENDING | APPROVED | REJECTED — admin təsdiqi tələb olunur.
  status String @default("PENDING")

  invitedAt  DateTime  @default(now())
  approvedAt DateTime?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([agencyId, status])
}

/// Aktiv giriş sessiyaları. Cookie yalnız bu sətrin id-sini daşıyır, beləliklə
/// oğurlanmış cookie və ya işdən çıxan əməkdaşın girişi dərhal ləğv edilə bilir.
model Session {
  id          String    @id @default(cuid())
  userId      String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  ip          String?
  userAgent   String?
  revokedAt   DateTime?
  /// Sessiyanı açan TOTP addımı — eyni kodun təkrar oynadılmasının qarşısını alır
  totpCounter Int?
  /// STAFF_2FA | PUBLIC — sessiyanın hansı doğrulama axınından gəldiyi
  authKind    String @default("STAFF_2FA")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// 2FA cihazı itirildikdə istifadə olunan birdəfəlik kodlar.
/// Kodlar yüksək entropiyalı təsadüfi dəyərlərdir, ona görə SHA-256 kifayətdir —
/// PBKDF2 burada yalnız boş yerə CPU yeyərdi.
model BackupCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Təhlükəsizlik jurnalı — uğurlu və uğursuz giriş cəhdləri.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  /// OK | BAD_PASSWORD | BAD_TOTP | LOCKED | RATE_LIMITED | INACTIVE
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// TAKSONOMİYA
// ---------------------------------------------------------------------------

model PropertyType {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  imageUrl    String?
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  properties  Property[]
}

/// Yerləşmə ağacı. Bakı bazarında yer dörd paralel açarla göstərilir və istifadəçi
/// hər hansı biri ilə axtarır: rayon, metro, qəsəbə/mikrorayon, nişangah.
/// kind = "CITY" | "DISTRICT" | "METRO" | "SETTLEMENT" | "LANDMARK"
model Location {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  kind     String  @default("CITY")
  parentId String?
  order    Int     @default(0)

  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationTree")

  propertiesInCity     Property[] @relation("PropertyCity")
  propertiesInDistrict Property[] @relation("PropertyDistrict")
  projects             Project[]  @relation("ProjectCity")

  @@index([parentId])
  @@index([kind])
}

/// Əmlak xüsusiyyətləri (hovuz, qaraj, lift, ...).
model Feature {
  id      String @id @default(cuid())
  name    String
  slug    String @unique
  icon    String?
  group   String @default("GENERAL") // GENERAL | INDOOR | OUTDOOR | SECURITY
  order   Int    @default(0)

  properties PropertyFeature[]
}

model PropertyFeature {
  propertyId String
  featureId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feature  Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([propertyId, featureId])
  @@index([featureId])
}

// ---------------------------------------------------------------------------
// ƏMLAK
// ---------------------------------------------------------------------------

model Property {
  id          String @id @default(cuid())
  title       String
  slug        String @unique
  description String

  /// SALE = Satılır, RENT = Kirayə
  listingType String @default("SALE")
  /// DRAFT | PENDING | PUBLISHED | RESERVED | SOLD | RENTED | ARCHIVED
  status      String @default("DRAFT")

  price    Float
  currency String @default("AZN")
  /// Kirayə üçün: MONTH | DAY — satış üçün null
  pricePeriod String?

  typeId     String
  cityId     String
  districtId String?
  address    String?
  latitude   Float?
  longitude  Float?

  rooms       Int?
  bedrooms    Int?
  bathrooms   Int?
  area        Float?
  /// Torpaq sahəsi, sot (1 sot = 100 m²). Torpaq və həyət evi elanlarında m²-nin yerini tutur.
  landArea    Float?
  floor       Int?
  totalFloors Int?

  /// COSMETIC | RENOVATED | DESIGNER | UNRENOVATED | NEW_BUILDING
  renovation     String?
  /// TITLE_DEED (çıxarış) | CONTRACT (müqavilə) | NONE
  documentStatus String?

  videoUrl String?

  /// NEW = yeni tikili, OLD = köhnə tikili. Yerli bazarda bu, əmlak növündən ayrı
  /// ikinci ölçüdür: qiymət, sənəd vəziyyəti və ipoteka uyğunluğu birbaşa ondan asılıdır.
  buildingType String? // NEW | OLD
  /// İpoteka Fondunun şərtlərinə uyğundur
  mortgageAvailable    Boolean @default(false)
  /// Tikinti şirkətinin daxili taksiti mövcuddur
  installmentAvailable Boolean @default(false)

  isFeatured Boolean @default(false)
  /// Nümunə/demo qeydi — real məlumatla əvəzlənəndə false olur.
  isDemo     Boolean @default(false)

  viewCount   Int       @default(0)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  metaTitle       String?
  metaDescription String?
  /// Google-a "bu URL-i indeksləşdirmə" deyir — duplikat və ya keçici səhifələr üçün.
  noIndex         Boolean @default(false)
  /// Boş buraxılsa canonical öz URL-inə işarə edir; yalnız duplikat kontent halında doldurulur.
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?

  type     PropertyType @relation(fields: [typeId], references: [id])
  city     Location     @relation("PropertyCity", fields: [cityId], references: [id])
  district Location?    @relation("PropertyDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  author   User?        @relation("PropertyAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  images    PropertyImage[]
  features  PropertyFeature[]
  leads     Lead[]
  favorites Favorite[]

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, listingType])
  @@index([typeId])
  @@index([cityId])
  @@index([districtId])
  @@index([price])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([publishedAt])
  @@index([authorId])
}

model PropertyImage {
  id         String  @id @default(cuid())
  propertyId String
  url        String
  thumbUrl   String?
  alt        String  @default("")
  width      Int?
  height     Int?
  order      Int     @default(0)
  isCover    Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, order])
}

// ---------------------------------------------------------------------------
// LAYİHƏLƏR
// ---------------------------------------------------------------------------

model Project {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String
  summary     String?

  /// RESIDENTIAL | COMMERCIAL | VILLA | MIXED
  projectType String @default("RESIDENTIAL")
  /// PLANNED | ONGOING | COMPLETED
  status      String @default("ONGOING")

  cityId  String?
  address String?
  latitude  Float?
  longitude Float?

  startDate    DateTime?
  deliveryDate DateTime?
  year         Int?

  totalArea   Float?
  floors      Int?
  unitCount   Int?
  /// Sərbəst xüsusiyyət siyahısı — JSON massiv (string[]).
  highlights  String?
  /// Tikinti mərhələləri — JSON massiv ({ step, title, done }[]).
  timeline    String?

  coverUrl String?
  isDemo   Boolean @default(false)
  isActive Boolean @default(true)
  order    Int     @default(0)

  metaTitle       String?
  metaDescription String?
  /// Google-a "bu URL-i indeksləşdirmə" deyir — duplikat və ya keçici səhifələr üçün.
  noIndex         Boolean @default(false)
  /// Boş buraxılsa canonical öz URL-inə işarə edir; yalnız duplikat kontent halında doldurulur.
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  city       Location?      @relation("ProjectCity", fields: [cityId], references: [id], onDelete: SetNull)
  images     ProjectImage[]
  properties Property[]

  @@index([status])
  @@index([deletedAt])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  thumbUrl  String?
  alt       String  @default("")
  /// EXTERIOR | INTERIOR | CONSTRUCTION | LANDSCAPE
  category  String  @default("EXTERIOR")
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

// ---------------------------------------------------------------------------
// XİDMƏTLƏR
// ---------------------------------------------------------------------------

model Service {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  shortDescription String
  description      String
  icon             String  @default("Building2")
  imageUrl         String?
  /// Sərbəst maddələr — JSON massiv (string[]).
  bullets          String?
  order            Int     @default(0)
  isActive         Boolean @default(true)

  metaTitle       String?
  metaDescription String?
  /// Google-a "bu URL-i indeksləşdirmə" deyir — duplikat və ya keçici səhifələr üçün.
  noIndex         Boolean @default(false)
  /// Boş buraxılsa canonical öz URL-inə işarə edir; yalnız duplikat kontent halında doldurulur.
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// BLOQ
// ---------------------------------------------------------------------------

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  order       Int        @default(0)
  posts       BlogPost[]
}

model BlogPost {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  excerpt    String
  content    String
  coverUrl   String?
  coverAlt   String  @default("")
  categoryId String?
  authorId   String?

  /// DRAFT | PUBLISHED | ARCHIVED
  status      String    @default("DRAFT")
  isDemo      Boolean   @default(false)
  viewCount   Int       @default(0)
  readMinutes Int       @default(3)
  publishedAt DateTime?

  metaTitle       String?
  metaDescription String?
  /// Google-a "bu URL-i indeksləşdirmə" deyir — duplikat və ya keçici səhifələr üçün.
  noIndex         Boolean @default(false)
  /// Boş buraxılsa canonical öz URL-inə işarə edir; yalnız duplikat kontent halında doldurulur.
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// MÜRACİƏTLƏR (LEADS)
// ---------------------------------------------------------------------------

model Lead {
  id      String  @id @default(cuid())
  name    String
  phone   String
  email   String?
  subject String?
  message String

  /// PROPERTY | CONTACT | SERVICE | PROJECT
  source String @default("CONTACT")
  /// NEW | CONTACTED | IN_PROGRESS | COMPLETED | CLOSED
  status String @default("NEW")

  propertyId String?
  adminNote  String?
  assigneeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignee User?     @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// FAVORİTLƏR
// ---------------------------------------------------------------------------

/// Qeydiyyatsız istifadəçilər üçün favoritlər localStorage-də saxlanılır.
/// Bu model gələcək istifadəçi hesabları üçün backend sinxronizasiyasını təmin edir.
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// MEDİA VƏ PARAMETRLƏR
// ---------------------------------------------------------------------------

model Media {
  id           String  @id @default(cuid())
  url          String  @unique
  thumbUrl     String?
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String  @default("")
  uploaderId   String?

  createdAt DateTime @default(now())

  uploader User? @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Panel əməliyyatlarının izi: kim, nə vaxt, hansı qeydə nə etdi.
/// Sətirlər heç vaxt yenilənmir və redaktorlar tərəfindən silinə bilmir.
model AuditLog {
  id       String @id @default(cuid())
  userId   String?
  userEmail String
  /// CREATE | UPDATE | DELETE | RESTORE | PUBLISH | LOGIN_REVOKE | ROLE_CHANGE | UPLOAD
  action   String
  /// Property | Project | BlogPost | Service | Lead | Media | User | Setting
  entity   String
  entityId String?
  /// Qısa insan oxunaqlı təsvir (məsələn elanın başlığı).
  summary  String?
  ip       String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/// Yüngül domen hadisə jurnalı (outbox pattern). D1 tranzaksiya dəstəkləmədiyi
/// üçün tam event-sourcing/CQRS burada mənasız risk daşıyır — bunun əvəzinə
/// hər əhəmiyyətli yazı əməliyyatından sonra ayrıca INSERT ilə hadisə qeyd olunur.
/// `AuditLog`-dan fərqi: bu, "kim etdi" deyil, "sistemdə nə baş verdi" səviyyəsidir
/// və gələcəkdə bildiriş/analitika abunəçiləri üçün mənbədir.
model DomainEvent {
  id   String @id @default(cuid())
  /// property.published | agency.employee_requested | lead.created və s.
  type       String
  entityType String
  entityId   String
  /// JSON sətir kimi saxlanılır — D1-də native JSON tipi yoxdur.
  payload    String?

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// YÖNLƏNDİRMƏLƏR VƏ 404 İZLƏMƏSİ
// ---------------------------------------------------------------------------

/// Köhnə/dəyişmiş URL-ləri yeni ünvana yönləndirir. `/[...slug]` catch-all
/// route-u hər 404-də bu cədvəli yoxlayır — uyğunluq tapılmasa əsl 404 göstərilir.
model Redirect {
  id         String   @id @default(cuid())
  /// Aparıcı `/` ilə, sorğu sətri olmadan — məsələn `/emlaklar/kohne-slug`.
  fromPath   String   @unique
  toPath     String
  /// 301 = daimi (SEO dəyərini ötürür), 302 = müvəqqəti.
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  hitCount   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// Uyğun yönləndirməsi olmayan 404-lərin qeydi — admin bunlardan hansı
/// yönləndirmələrin əlavə edilməli olduğunu görür.
model NotFoundHit {
  id          String   @id @default(cuid())
  path        String   @unique
  count       Int      @default(1)
  referrer    String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([count])
}
