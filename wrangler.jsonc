{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luxehomeestate",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Custom domain — DNS yazıları Cloudflare tərəfindən avtomatik idarə olunur
  "routes": [
    { "pattern": "luxehomeestate.az", "custom_domain": true },
    { "pattern": "www.luxehomeestate.az", "custom_domain": true }
  ],

  "vars": {
    // İdarə paneli qapısı — prod admin istifadəyə açıqdır
    "ADMIN_ENABLED": "true",
    // Dinamik səhifələrdə runtime-da oxunur; statik səhifələr üçün deploy skripti
    // eyni dəyəri build prosesinə də ötürür
    "SITE_URL": "https://luxehomeestate.az",
    // Public açardır; gizli açar `TURNSTILE_SECRET` Worker secret-i kimi saxlanılır
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEfhXUNNmS0Ka_DO",
    // Siteverify cavabındakı hostname yalnız bu production frontend-lərdən biri olmalıdır
    "TURNSTILE_HOSTNAMES": "luxehomeestate.az,www.luxehomeestate.az",
    // Admin "Search Analytics" paneli GraphQL Analytics API sorğusunda istifadə edir —
    // sirr deyil, sadəcə hansı zona/hesabın sorğulanacağını göstərir
    "CF_ZONE_ID": "d401a9f612bc47ed88e1c14e658141d1",
    "CF_ACCOUNT_ID": "8e6ae175474aa8e5033b3b9087775250"
  },

  // Giriş və əlaqə formu üçün sürət limiti — Workers doğma binding-i
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONTACT_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "MONITORING_LIMIT", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    // Paneldəki yazma əməliyyatları — oğurlanmış sessiya ilə kütləvi dəyişikliyi ləngidir
    { "name": "ADMIN_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],

  // next/image optimizasiyası Cloudflare Images binding üzərindən işləyir
  "images": {
    "binding": "IMAGES"
  },

  // Workers AI — elan təsviri və foto keyfiyyət analizi (`src/lib/ai.ts`).
  // Xarici AI provayderi (OpenAI) qəsdən işlədilmir: binding hesab daxilində qalır,
  // ayrıca API açarı saxlanmır və elan məlumatı üçüncü tərəfə göndərilmir.
  // Bir Worker layihəsində yalnız bir AI binding ola bilər.
  "ai": {
    "binding": "AI"
  },

  // ISR/revalidate üçün OpenNext-in özünə müraciəti
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "luxehomeestate"
    }
  ],

  // Əsas verilənlər bazası — Prisma @prisma/adapter-d1 ilə bu binding-i istifadə edir
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luxehome-db",
      "database_id": "86d5f7e0-ffe6-48d8-bd84-d88163550b2a"
    },
    {
      // OpenNext on-demand revalidation tag-ləri. Kiçik layihədə əsas D1
      // bazasındakı ayrıca `revalidations` cədvəlindən istifadə olunur.
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "luxehome-db",
      "database_id": "86d5f7e0-ffe6-48d8-bd84-d88163550b2a"
    }
  ],

  "r2_buckets": [
    {
      // Admin paneldən yüklənən əmlak/layihə/blog şəkilləri
      "binding": "MEDIA",
      "bucket_name": "luxehome-media"
    },
    {
      // OpenNext incremental cache (ISR nəticələri)
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "luxehome-next-cache"
    }
  ],

  // Staging — prod resurslarından tam təcrid olunub. Wrangler-də vars, d1_databases,
  // r2_buckets, services, ratelimits və assets irsi ötürülməyən açarlardır: hər biri
  // burada təkrar yazılmasa, staging səssizcə prod resurslarına bağlanardı.
  "env": {
    "staging": {
      "name": "luxehomeestate-staging",
      "workers_dev": true,

      // Custom domain qəsdən yoxdur — staging yalnız workers.dev ünvanında açılır.
      // Boş massiv **mütləqdir**: `routes` irsi ötürülən açardır və burada
      // yazılmasa, staging yayımı luxehomeestate.az domenini prod worker-dən
      // alıb staging-ə bağlayır (wrangler bunu yalnız xəbərdarlıq kimi bildirir).
      "routes": [],

      "observability": { "enabled": true },

      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },

      "images": { "binding": "IMAGES" },
      "ai": { "binding": "AI" },

      "vars": {
        // Panel yalnız staging-də açıqdır
        "ADMIN_ENABLED": "true",
        // robots.ts və seo.ts bunu görüb bütün səhifələri indeksdən çıxarır
        "IS_STAGING": "true",
        "SITE_URL": "https://luxehomeestate-staging.amiyevbahadur.workers.dev",
        // Public site key sirr deyil. Staging Turnstile secret-i ayrıca Worker secret-i kimi saxlanılır.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEfhXUNNmS0Ka_DO",
        "TURNSTILE_HOSTNAMES": "luxehomeestate-staging.amiyevbahadur.workers.dev",
        // `vars` mühitlərə irsi ötürülmür — bu iki açar yuxarıda olsa da burada
        // təkrarlanmalıdır, əks halda staging-də «Trafik analitikası» paneli
        // GraphQL sorğusunu qura bilmir. Zona və hesab prod ilə eynidir:
        // staging öz custom domenini almır, ona görə ölçülən zona da eyni qalır.
        "CF_ZONE_ID": "d401a9f612bc47ed88e1c14e658141d1",
        "CF_ACCOUNT_ID": "8e6ae175474aa8e5033b3b9087775250"
      },

      "ratelimits": [
        { "name": "LOGIN_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "CONTACT_LIMIT", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
        { "name": "MONITORING_LIMIT", "namespace_id": "2004", "simple": { "limit": 60, "period": 60 } },
        { "name": "ADMIN_LIMIT", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } }
      ],

      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "luxehomeestate-staging"
        }
      ],

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "luxehome-db-staging",
          "database_id": "295ea904-c268-4722-897f-39563c3ec87b"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "luxehome-db-staging",
          "database_id": "295ea904-c268-4722-897f-39563c3ec87b"
        }
      ],

      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "luxehome-media-staging"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "luxehome-next-cache-staging"
        }
      ]
    }
  }
}
