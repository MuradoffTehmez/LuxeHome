{
  "name": "luxehomeestate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": "^12.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "cross-env SITE_URL=https://luxehomeestate.az IS_STAGING=false NEXT_PUBLIC_GTM_ID=GTM-MMV4VC9L opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env=\"\"",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "prisma generate",
    "db:migrate:new": "prisma migrate diff --from-local-d1 --to-schema-datamodel prisma/schema.prisma --script",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:build": "tsx prisma/build-seed-sql.ts",
    "db:seed:local": "wrangler d1 execute DB --local --file=prisma/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=prisma/seed.sql",
    "db:clean-demo:local": "wrangler d1 execute DB --local --file=prisma/remove-demo-content.sql",
    "db:clean-demo:remote": "wrangler d1 execute DB --remote --file=prisma/remove-demo-content.sql",
    "db:clean-demo:staging": "wrangler d1 execute DB --remote --env staging --file=prisma/remove-demo-content.sql",
    "db:demo:build": "tsx prisma/build-demo-content.ts",
    "db:demo:local": "wrangler d1 execute DB --local --file=prisma/demo-content.sql",
    "db:demo:staging": "wrangler d1 execute DB --remote --env staging --file=prisma/demo-content.sql",
    "db:demo:remote": "wrangler d1 execute DB --remote --file=prisma/demo-content.sql",
    "db:studio": "prisma studio",
    "deploy:staging": "cross-env SITE_URL=https://luxehomeestate-staging.amiyevbahadur.workers.dev IS_STAGING=true opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env staging",
    "deploy:cron": "wrangler deploy --config workers/saved-search-cron/wrangler.jsonc --env=\"\"",
    "deploy:cron:staging": "wrangler deploy --config workers/saved-search-cron/wrangler.jsonc --env staging",
    "preview:staging": "cross-env SITE_URL=https://luxehomeestate-staging.amiyevbahadur.workers.dev IS_STAGING=true opennextjs-cloudflare build && opennextjs-cloudflare preview -- --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:seed:staging": "wrangler d1 execute DB --remote --env staging --file=prisma/seed.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:mobile": "playwright test --project=mobile",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install --with-deps chromium",
    "test:seo:routes": "node scripts/seo-route-status-smoke.mjs",
    "test:seo:live": "node scripts/serp-live-acceptance.mjs",
    "auth:create-admin": "tsx prisma/create-admin.ts",
    "db:taxonomy:build": "tsx prisma/build-taxonomy-sql.ts",
    "db:taxonomy:local": "wrangler d1 execute luxehome-db --local --file=prisma/taxonomy.sql",
    "db:taxonomy:remote": "wrangler d1 execute luxehome-db --remote --file=prisma/taxonomy.sql",
    "db:taxonomy:staging": "wrangler d1 execute luxehome-db-staging --remote --env staging --file=prisma/taxonomy.sql",
    "db:knowledge:build": "tsx prisma/build-knowledge-hub-sql.ts",
    "db:knowledge:local": "wrangler d1 execute DB --local --file=prisma/knowledge-hub.sql",
    "db:knowledge:remote": "wrangler d1 execute DB --remote --file=prisma/knowledge-hub.sql",
    "db:knowledge:staging": "wrangler d1 execute DB --remote --env staging --file=prisma/knowledge-hub.sql"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "next": "15.5.23",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "otpauth": "^9.5.1",
    "qrcode-svg": "^1.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.20.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "ultrahtml": "^1.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/qrcode-svg": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "//overrides": "Tranzitiv zəifliklər. Üçünün də düzəlişi yalnız yuxarı paketin (next, prisma) yeni buraxılışı ilə gələcək; o vaxta qədər versiya burada qaldırılır. Yuxarı paket yeniləndikdə bu blok yenidən qiymətləndirilməlidir.",
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "$sharp",
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "sharp@0.34.5": true
  }
}
