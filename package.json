{
  "name": "luxehomeestate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env \"\"",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "prisma generate",
    "db:migrate:new": "prisma migrate diff --from-local-d1 --to-schema-datamodel prisma/schema.prisma --script",
    "db:migrate:local": "wrangler d1 migrations apply luxehome-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply luxehome-db --remote",
    "db:seed:build": "tsx prisma/build-seed-sql.ts",
    "db:seed:local": "wrangler d1 execute luxehome-db --local --file=prisma/seed.sql",
    "db:seed:remote": "wrangler d1 execute luxehome-db --remote --file=prisma/seed.sql",
    "db:studio": "prisma studio",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env staging",
    "preview:staging": "opennextjs-cloudflare build && opennextjs-cloudflare preview -- --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply luxehome-db-staging --remote",
    "db:seed:staging": "wrangler d1 execute luxehome-db-staging --remote --file=prisma/seed.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:create-admin": "tsx prisma/create-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "15.5.23",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.20.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "sharp@0.34.5": true
  }
}
